; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project-dreamer"
run/main_scene="uid://re723q2wgqky"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Toolkit="*res://addons/godottoolkit/toolkit.gd"
DebugMenu="*res://addons/debug_menu/debug_menu.tscn"
g="*res://Misc/Globals.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=640
window/size/viewport_height=420
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/extra_snaps/plugin.cfg", "res://addons/godottoolkit/plugin.cfg", "res://addons/scene_tools/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "blue",
"res://Common/": "gray",
"res://Entities/": "red",
"res://Environment/": "teal",
"res://Environment/Post Processing/": "purple",
"res://Environment/Research_Base/Interactable/": "red",
"res://Environment/Research_Base/Interactable/Items/": "yellow",
"res://Textures/": "pink",
"res://addons/": "gray"
}

[importer_defaults]

scene={
